# --- Groq ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=1500

# --- GitHub (optional, raises rate limit from 60/hr to 5000/hr) ---
GITHUB_TOKEN=

# --- Optional API key auth (leave blank to disable, see app/core/security.py) ---
API_KEY=

# --- Database ---
# Local dev default (no setup needed):
DATABASE_URL=sqlite:///./roastmycode.db
# Production example (Render/Railway/Supabase Postgres):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/roastmycode

# --- App ---
ENV=development
ALLOWED_ORIGINS=*
MAX_RESUME_SIZE_MB=5
