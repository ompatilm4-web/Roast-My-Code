# ============================================================
# RoastMyCode Backend - Environment Configuration
# ============================================================

# --- Groq LLM (REQUIRED for AI roasting) ---
# Get a FREE key at: https://console.groq.com/keys
# If blank or invalid, app falls back to the heuristic engine automatically.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=1500

# --- GitHub API Token (Optional but RECOMMENDED) ---
# Raises rate limit from 60/hr → 5,000/hr per IP.
# Get from: https://github.com/settings/tokens (no scopes needed for public repos)
GITHUB_TOKEN=

# --- Optional Global API Key Auth ---
# Leave blank to allow public access (good for demos).
# Set a value to require X-API-Key header on all roast endpoints.
API_KEY=

# --- Database ---
# SQLite (no setup needed for local dev):
DATABASE_URL=sqlite:///./roastmycode.db
# PostgreSQL example for production:
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/roastmycode

# --- App ---
APP_NAME=RoastMyCode API
ENV=development
ALLOWED_ORIGINS=*
MAX_RESUME_SIZE_MB=5

# --- JWT Authentication (DO NOT CHANGE in production without re-issuing all tokens) ---
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Fallback Engine ---
# Set to True to use heuristic roaster when Groq is unavailable.
ALLOW_FALLBACK_ROASTER=True
